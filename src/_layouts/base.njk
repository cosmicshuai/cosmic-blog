<!DOCTYPE html>
<html lang="{{ site.language | default('en') }}" class="no-js dark">
{% include "head.njk" %}
<!-- No background on <body>: html supplies the base colour, and an
     opaque body background would paint over the negative-z starfield. -->
<body class="min-h-screen font-sans text-ink antialiased">

  {% include "overlays.njk" %}

  <!-- Static starfield. Purely decorative, sits behind content, never
       overlaps text and never moves. -->
  <div class="starfield" aria-hidden="true"></div>

  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[10001] focus:border focus:border-signal focus:bg-bg focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-signal">
    skip to content
  </a>

  {% include "rail.njk" %}

  <main id="content" class="mx-auto max-w-screenframe px-4 pb-20 pt-24 sm:px-6 sm:pt-28">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <div class="h-8" aria-hidden="true"></div>
  {% include "statusline.njk" %}
</body>
</html>
