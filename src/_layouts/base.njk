<!DOCTYPE html>
<html lang="{{ site.language | default('en') }}" class="no-js">
{% include "head.njk" %}
<body class="min-h-screen bg-bg font-mono text-p-body">

  {% include "overlays.njk" %}

  <!-- The tube. Purely decorative, never intercepts input. -->
  <div class="crt" aria-hidden="true">
    <div class="crt-roll"></div>
    <div class="crt-scan"></div>
    <div class="crt-grille"></div>
    <div class="crt-glass"></div>
    <div class="crt-flicker"></div>
    <div class="crt-vignette"></div>
  </div>

  <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[10001] focus:border focus:border-p focus:bg-bg focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-p">
    skip to content
  </a>

  {% include "rail.njk" %}

  <main id="content" class="mx-auto max-w-screenframe px-4 pb-20 pt-24 sm:px-6 sm:pt-28">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <div class="h-8" aria-hidden="true"></div>
  {% include "statusline.njk" %}
</body>
</html>
