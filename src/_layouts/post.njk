---
layout: base.njk
---

<!-- Reading progress — a thin trace across the top of the viewport. -->
<div class="fixed inset-x-0 top-0 z-[60] h-[2px] bg-transparent" aria-hidden="true">
  <div id="progress" class="h-full w-0 bg-signal transition-[width] duration-100 ease-out"></div>
</div>

<article class="pt-2">

  <!-- ══ FILE HEADER ═══════════════════════════════════════════════ -->
  <header class="mb-14">
    <nav class="mb-6 font-mono text-xs text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-signal">~</a>
      <span class="text-line-2" aria-hidden="true">/</span>
      <a href="/posts/" class="transition-colors hover:text-signal">posts</a>
      <span class="text-line-2" aria-hidden="true">/</span>
      <span class="text-ink-dim">{{ page.fileSlug }}.md</span>
    </nav>

    <h1 class="title-card max-w-[24ch] text-[clamp(2.25rem,7vw,4.5rem)] leading-[1.05]">
      {{ title }}
    </h1>

    {% if description %}
      <p class="mt-5 max-w-measure font-mono text-base leading-relaxed text-ink-dim">{{ description }}</p>
    {% endif %}

    <!-- stat(1) -->
    <dl class="mt-8 grid grid-cols-2 gap-px border border-line bg-line sm:grid-cols-4">
      {% set meta = [
        { k: "written", v: date | readableDate },
        { k: "read", v: content | readingTime + " min" },
        { k: "words", v: content | wordCount },
        { k: "mode", v: "-rw-r--r--" }
      ] %}
      {% for m in meta %}
        <div class="bg-bg px-3 py-2.5">
          <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">{{ m.k }}</dt>
          <dd class="mt-1 font-mono text-sm text-ink-hi">{{ m.v }}</dd>
        </div>
      {% endfor %}
    </dl>

    {% if tags %}
      <div class="mt-4 flex flex-wrap gap-2">
        {% for tag in tags %}
          {% if tag != "posts" %}
            <a href="/tags/{{ tag | slugify }}/" class="tag">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <!-- ══ BODY ══════════════════════════════════════════════════════ -->
  <div class="post-content">
    {{ content | safe }}
  </div>

  <!-- ══ EOF ═══════════════════════════════════════════════════════ -->
  <footer class="mt-20 border-t border-line pt-10">

    <p class="mb-10 font-mono text-sm text-ink-faint">
      <span class="text-signal/60">$</span> EOF — {{ content | wordCount }} words, {{ content | readingTime }} min
    </p>

    <div class="panel bracketed group mb-10">
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> author</span>
        <span class="text-signal/50">uid 1000</span>
      </div>
      <div class="panel-body pool flex items-center gap-5">
        <span aria-hidden="true" class="flex h-14 w-14 shrink-0 items-center justify-center border border-line bg-bg-deep/50 crawl-type text-2xl leading-none text-signal">
          {{ site.author | first | upper }}
        </span>
        <span class="min-w-0">
          <a href="/about/" class="block font-mono text-sm text-ink-hi transition-colors hover:text-signal">{{ site.author }}</a>
          <span class="mt-0.5 block font-mono text-xs text-ink-dim">{{ site.role }}</span>
        </span>
        <a href="/feed.xml" class="btn-ghost ml-auto hidden shrink-0 sm:inline-flex">subscribe</a>
      </div>
    </div>

    {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.posts | getNextCollectionItem(page) %}

    {% if previousPost or nextPost %}
      <nav class="grid gap-4 sm:grid-cols-2" aria-label="Adjacent records">
        {% if previousPost %}
          <a href="{{ previousPost.url }}" class="group panel bracketed pool block p-4 transition-colors hover:border-signal/50">
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">◂ previous</span>
            <span class="mt-2 block font-mono text-sm text-ink-hi transition-colors group-hover:text-signal">{{ previousPost.data.title }}</span>
          </a>
        {% else %}<span class="hidden sm:block"></span>{% endif %}

        {% if nextPost %}
          <a href="{{ nextPost.url }}" class="group panel bracketed pool block p-4 text-right transition-colors hover:border-signal/50">
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">next ▸</span>
            <span class="mt-2 block font-mono text-sm text-ink-hi transition-colors group-hover:text-signal">{{ nextPost.data.title }}</span>
          </a>
        {% endif %}
      </nav>
    {% endif %}

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/posts/" class="btn-ghost"><span aria-hidden="true">←</span> archive</a>
      <a href="/" class="btn-ghost">index</a>
    </div>
  </footer>
</article>
