---
layout: base.njk
title: Frame buffer
section: photos
description: Light, captured and quantised.
---
{% from "macros.njk" import rule %}

<header class="mb-12 pt-4">
  <p class="mb-3 font-mono text-sm text-p-dim">
    <span class="text-p glow-sm">$</span> cat /dev/fb0 | display
  </p>
  <h1 class="aberrate font-display text-[clamp(2.5rem,9vw,5.5rem)] uppercase leading-[0.9] text-p">Frame buffer</h1>
  <p class="mt-4 max-w-measure font-mono text-sm leading-relaxed text-p-dim">
    <span class="text-p-hi">{{ photos.length | default(0) }}</span> frames.
    Rendered in amber until you look closer — hover or focus a frame to restore full colour.
  </p>
</header>

{% if photos.length === 0 %}
  <div class="panel bracketed group">
    <div class="panel-hd">
      <span><span class="text-p/50" aria-hidden="true">▚▚</span> fb0</span>
      <span class="text-p/50">0 frames</span>
    </div>
    <div class="panel-body">
      <p class="font-display text-3xl text-p glow">BUFFER EMPTY</p>
      <p class="mt-3 max-w-measure font-mono text-sm text-p-dim">
        Add entries to <code class="border border-line-2 px-1 py-0.5">src/_data/photos.json</code>
        with files in <code class="border border-line-2 px-1 py-0.5">src/assets/photos/</code>.
      </p>
    </div>
  </div>
{% else %}
  <div class="frame-grid" data-reveal>
    {% for photo in photos %}
      <figure class="photo-item duotone group relative mb-4 block w-full cursor-pointer break-inside-avoid border border-line bg-bg-deep/40 transition-colors hover:border-p/60"
              role="button" tabindex="0" aria-label="Open frame {{ loop.index }}{% if photo.caption %} — {{ photo.caption }}{% endif %}">

        <figcaption class="flex items-center justify-between gap-3 border-b border-line px-2.5 py-1 font-pixel text-[10px] uppercase tracking-widest text-p-faint">
          <span>frame {{ "0" if loop.index < 10 }}{{ loop.index }}</span>
          <span class="text-p/50 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">⛶</span>
        </figcaption>

        <div class="relative overflow-hidden">
          {% galleryImage photo.src, photo.alt, "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw", "gallery-image block w-full h-auto" %}

          <!-- Crosshair reticle on hover -->
          <span aria-hidden="true" class="pointer-events-none absolute inset-3 border border-p/0 transition-colors duration-300 group-hover:border-p/40"></span>
        </div>

        {% if photo.caption %}
          <span class="hidden photo-caption" data-caption="{{ photo.caption }}"></span>
          <div class="border-t border-line px-2.5 py-2 font-mono text-xs text-p-dim transition-colors group-hover:text-p-hi">
            {{ photo.caption }}
          </div>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
{% endif %}

<!-- ══ VIEWPORT ══════════════════════════════════════════════════════ -->
<div id="lightbox" hidden class="fixed inset-0 z-[9999] flex items-center justify-center p-4 sm:p-8"
     role="dialog" aria-modal="true" aria-label="Frame viewer">
  <div data-lightbox-backdrop class="absolute inset-0 bg-bg-deep/95 backdrop-blur-sm"></div>

  <div class="panel relative flex max-h-full w-full max-w-5xl flex-col shadow-bloom-lg">
    <div class="panel-hd">
      <span><span class="text-p/50" aria-hidden="true">▚▚</span> viewport</span>
      <span class="flex items-center gap-3">
        <span data-lightbox-counter class="text-p/60">1/1</span>
        <button type="button" id="lightbox-close" class="text-p/60 transition-colors hover:text-p" aria-label="Close viewer">✕</button>
      </span>
    </div>

    <div class="relative flex min-h-0 flex-1 items-center justify-center bg-bg-deep/60 p-3">
      <img id="lightbox-image" src="" alt="" class="max-h-[68vh] w-auto max-w-full object-contain">
    </div>

    <div class="flex items-center justify-between gap-3 border-t border-line px-3 py-2">
      <button type="button" id="lightbox-prev" class="btn-ghost !px-3 !py-1" aria-label="Previous frame">←</button>
      <p id="lightbox-caption" class="min-w-0 flex-1 truncate text-center font-mono text-xs text-p-dim"></p>
      <button type="button" id="lightbox-next" class="btn-ghost !px-3 !py-1" aria-label="Next frame">→</button>
    </div>
  </div>
</div>
