---
pagination:
  data: collections.validTagList
  size: 1
  alias: tag
  addAllPagesToCollections: true
layout: base.njk
section: tags
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: 'Topic: {{ tag }}'
  description: 'Every record tagged {{ tag }}.'
---
{% from "macros.njk" import lsRow %}

{% set postslist = collections.posts | getByTag(tag) %}

<header class="mb-12 pt-4">
  <p class="mb-3 font-mono text-sm text-p-dim">
    <span class="text-p glow-sm">$</span> grep -l '#{{ tag }}' ~/posts/*.md
  </p>
  <h1 class="aberrate font-display text-[clamp(2.5rem,9vw,5.5rem)] uppercase leading-[0.9] text-p">
    <span class="text-p/35" aria-hidden="true">#</span>{{ tag }}
  </h1>
  <p class="mt-4 font-mono text-sm text-p-dim">
    <span class="text-p-hi">{{ postslist.length }}</span>
    {{ "record" if postslist.length == 1 else "records" }} matched.
  </p>
</header>

<div class="panel" data-reveal>
  <div class="panel-hd">
    <span><span class="text-p/50" aria-hidden="true">▚▚</span> ~/posts &mdash; filtered</span>
    <span class="text-p/50">#{{ tag }}</span>
  </div>

  {% if postslist.length === 0 %}
    <div class="panel-body">
      <p class="font-mono text-sm text-p-dim">No records carry this tag.</p>
    </div>
  {% else %}
    <ul class="divide-y divide-line/60">
      {% for post in postslist %}
        {{ lsRow(post, tag) }}
      {% endfor %}
    </ul>
  {% endif %}
</div>

<div class="mt-8 flex flex-wrap gap-3">
  <a href="/tags/" class="btn-ghost"><span aria-hidden="true">←</span> all topics</a>
  <a href="/posts/" class="btn-ghost">full archive</a>
</div>
