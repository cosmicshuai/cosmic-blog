<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-signal/50 to-transparent"></div>

  <div class="mx-auto flex h-14 max-w-screenframe items-center gap-4 px-4 sm:px-6">

    <!-- Machine mark -->
    <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="{{ site.title }} — home">
      <span aria-hidden="true" class="text-lg leading-none text-signal transition-transform duration-300 group-hover:translate-x-0.5">◤</span>
      <span class="crawl-type text-sm text-ink-hi transition-colors group-hover:text-signal">COSMIC</span>
    </a>

    <!-- Primary nav -->
    <nav class="ml-auto hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {% for item in nav %}
        {% set active = (section == item.section) %}
        <a href="{{ item.url }}"
           class="group relative px-2.5 py-1.5 font-mono text-xs uppercase tracking-wider transition-colors duration-200 {% if active %}text-signal{% else %}text-ink-dim hover:text-ink-hi{% endif %}"
           {% if active %}aria-current="page"{% endif %}>
          <span aria-hidden="true" class="text-signal/40 transition-opacity duration-200 {% if active %}opacity-100{% else %}opacity-0 group-hover:opacity-100{% endif %}">[</span>{{ item.label }}<span aria-hidden="true" class="text-signal/40 transition-opacity duration-200 {% if active %}opacity-100{% else %}opacity-0 group-hover:opacity-100{% endif %}">]</span>
          {% if active %}
            <span aria-hidden="true" class="absolute inset-x-2 -bottom-px h-px bg-signal shadow-signal"></span>
          {% endif %}
        </a>
      {% endfor %}
    </nav>

    <!-- Command trigger -->
    <button type="button" data-cmdk-open
            class="ml-auto flex items-center gap-2 border border-line-2 px-2.5 py-1.5 font-mono text-[11px] text-ink-dim transition-colors hover:border-signal/60 hover:text-signal md:ml-2"
            aria-label="Open command palette">
      <span aria-hidden="true">▸</span>
      <span class="hidden sm:inline">search</span>
      <kbd class="kbd ml-1 hidden sm:inline-flex" data-cmdk-hint>⌘K</kbd>
    </button>

    <!-- Mobile menu -->
    <button type="button" data-nav-toggle
            class="border border-line-2 px-2.5 py-1.5 font-mono text-[11px] text-ink-dim transition-colors hover:border-signal/60 hover:text-signal md:hidden"
            aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation menu">
      <span data-nav-label>MENU</span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" data-nav-menu hidden
       class="border-t border-line bg-bg/95 backdrop-blur-md md:hidden">
    <nav class="mx-auto max-w-screenframe px-4 py-2" aria-label="Primary mobile">
      {% for item in nav %}
        {% set active = (section == item.section) %}
        <a href="{{ item.url }}"
           class="flex items-baseline gap-3 border-l-2 px-3 py-3 font-mono text-sm transition-colors {% if active %}border-signal bg-signal/10 text-signal{% else %}border-transparent text-ink-dim hover:border-signal/50 hover:text-ink-hi{% endif %}"
           {% if active %}aria-current="page"{% endif %}>
          <span class="w-6 shrink-0 text-signal/40" aria-hidden="true">{{ loop.index }}</span>
          <span class="crawl-type">{{ item.label }}</span>
          <span class="ml-auto truncate text-[11px] text-ink-faint">{{ item.hint }}</span>
        </a>
      {% endfor %}
      <a href="/feed.xml"
         class="flex items-baseline gap-3 border-l-2 border-transparent px-3 py-3 font-mono text-sm text-ink-dim transition-colors hover:border-signal/50 hover:text-ink-hi">
        <span class="w-6 shrink-0 text-signal/40" aria-hidden="true">{{ nav.length + 1 }}</span>
        <span class="crawl-type">RSS</span>
        <span class="ml-auto truncate text-[11px] text-ink-faint">raw feed</span>
      </a>
    </nav>
  </div>
</header>
