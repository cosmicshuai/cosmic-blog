<div class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-bg/95 backdrop-blur-md font-mono text-[11px] leading-none">
  <div class="mx-auto flex h-8 max-w-screenframe items-center gap-4 px-4 sm:px-6">

    <!-- Link status -->
    <span class="flex shrink-0 items-center gap-1.5 text-ink-dim">
      <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-ok animate-bar-pulse" aria-hidden="true"></span>
      <span class="hidden sm:inline">ONLINE</span>
    </span>

    <span class="hidden text-line-2 lg:inline" aria-hidden="true">│</span>

    <!-- Scroll meter -->
    <span class="hidden shrink-0 items-center gap-2 text-ink-dim lg:flex">
      <span class="text-ink-faint">SCR</span>
      <span data-scroll-meter aria-hidden="true" class="tracking-[0.15em] text-signal/70">░░░░░░░░░░</span>
      <span data-scroll-pct class="w-9 text-right tabular-nums text-signal">0%</span>
    </span>

    <span class="hidden text-line-2 lg:inline" aria-hidden="true">│</span>

    <!-- Location -->
    <span class="min-w-0 flex-1 truncate text-ink-faint">
      <span class="text-signal/60" aria-hidden="true">▸</span>
      {{ site.url | replace("https://", "") }}<span class="text-ink-dim">{{ page.url }}</span>
    </span>

    <!-- Clock -->
    <span data-clock class="hidden shrink-0 tabular-nums text-ink-dim sm:inline">--:--:--Z</span>

    <span class="hidden text-line-2 sm:inline" aria-hidden="true">│</span>

    <button type="button" data-cmdk-open
            class="shrink-0 text-ink-dim transition-colors hover:text-signal"
            title="Search (⌘K)">
      ⌘K
    </button>

    <button type="button" data-help-open
            class="shrink-0 text-ink-dim transition-colors hover:text-signal"
            title="Keyboard shortcuts (?)">
      ?
    </button>
  </div>
</div>
