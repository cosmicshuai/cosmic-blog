---
layout: base.njk
title: Wire
section: wire
permalink: /wire/
description: Short dispatches, newest first — the microblog.
---
{% from "macros.njk" import rule %}

{% set notes = collections.notes %}

<header class="mb-12 pt-4">
  <p class="mb-3 font-mono text-sm text-p-dim">
    <span class="text-p glow-sm">$</span> tail -f /var/log/wire
  </p>
  <h1 class="aberrate font-display text-[clamp(2.5rem,9vw,5.5rem)] uppercase leading-[0.9] text-p">Wire</h1>
  <p class="mt-4 max-w-measure font-mono text-sm leading-relaxed text-p-dim">
    Short dispatches — half-thoughts, links, things not worth a whole record.
    <span class="text-p-hi">{{ notes.length }}</span>
    {{ "packet" if notes.length == 1 else "packets" }} on the line.
    <a href="/wire/feed.xml" class="border-b border-dashed border-p/50 text-p transition-colors hover:bg-p/15">Separate feed</a>
    — subscribing to the wire won't fill your reader with long-form, and vice versa.
  </p>
</header>

{% if notes.length === 0 %}

  <div class="panel bracketed group">
    <div class="panel-hd">
      <span><span class="text-p/50" aria-hidden="true">▚▚</span> /var/log/wire</span>
      <span class="text-p/50">0 packets</span>
    </div>
    <div class="panel-body pool">
      <p class="font-display text-3xl leading-none text-p glow sm:text-4xl">LINE QUIET</p>
      <p class="mt-4 max-w-measure font-mono text-sm leading-relaxed text-p-dim">
        The carrier is up and nothing has come across it yet. The first packet will
        land at the top of this log.
      </p>
      <p class="mt-6 font-mono text-sm text-p-faint">
        <span class="text-p/60">$</span> ls src/notes/*.md<br>
        <span class="text-warn">ls: no matches found</span>
      </p>
      <p class="mt-6 max-w-measure font-mono text-xs leading-relaxed text-p-faint">
        A packet is a Markdown file in
        <code class="border border-line-2 px-1 py-0.5 text-p-dim">src/notes/</code>
        named <code class="border border-line-2 px-1 py-0.5 text-p-dim">YYYY-MM-DD-HHMMSS.md</code>,
        with a <code class="border border-line-2 px-1 py-0.5 text-p-dim">date:</code> in its front
        matter and the text as the body. Nothing else.
      </p>
    </div>
  </div>

{% else %}

  <div class="panel" data-reveal>
    <div class="panel-hd">
      <span><span class="text-p/50" aria-hidden="true">▚▚</span> /var/log/wire</span>
      <span class="flex items-center gap-2 text-p/50">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-ok animate-bar-pulse" aria-hidden="true"></span>
        listening
      </span>
    </div>

    <!-- Live tail cursor: the log is open and waiting. -->
    <p class="border-b border-line px-4 py-2.5 font-mono text-xs text-p-faint">
      <span class="text-p/50" aria-hidden="true">▸</span>
      awaiting transmission<span class="cursor-block text-p" aria-hidden="true"></span>
    </p>

    <ol class="divide-y divide-line/60">
      {% for note in notes %}
        {% set seq = notes.length - loop.index0 %}
        {% set slug = note.date | noteId %}
        {% set thisDay = note.date | htmlDateString %}
        {% set prevDay = (notes[loop.index0 - 1].date | htmlDateString) if loop.index0 > 0 else "" %}

        {% if thisDay != prevDay %}
          <li class="flex items-center gap-4 bg-surface-2/40 px-4 py-1.5" aria-hidden="true">
            <span class="font-pixel text-[10px] uppercase tracking-widest text-p-dim">{{ thisDay }}</span>
            <span class="h-px flex-1 bg-[repeating-linear-gradient(to_right,rgb(var(--c-line-2))_0_4px,transparent_4px_9px)]"></span>
          </li>
        {% endif %}

        <li id="n-{{ slug }}" class="group relative border-l-2 border-transparent px-4 py-4 transition-colors duration-150 target:border-p target:bg-p/10 hover:border-p/60 hover:bg-p/[0.05]">

          <!-- Packet header -->
          <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-pixel text-[10px] uppercase tracking-widest text-p-faint">
            <span class="text-p/60">SEQ {{ seq | pad }}</span>
            <span aria-hidden="true" class="text-line-2">·</span>
            <time datetime="{{ note.date | dateToRfc3339 }}">{{ note.date | utcTime }}</time>
            <span aria-hidden="true" class="text-line-2">·</span>
            <span>{{ note.templateContent | charCount }} B</span>
            <a href="#n-{{ slug }}"
               class="ml-auto text-p/0 transition-colors group-hover:text-p/70 focus-visible:text-p"
               aria-label="Permalink to packet {{ seq }}">#</a>
          </div>

          <!-- Payload -->
          <div class="wire-body max-w-measure font-mono text-[15px] leading-[1.7] text-p-body">
            {{ note.templateContent | safe }}
          </div>
        </li>
      {% endfor %}
    </ol>

    <div class="border-t border-line px-4 py-2 font-mono text-[11px] text-p-faint">
      end of log — {{ notes.length }} {{ "packet" if notes.length == 1 else "packets" }}
    </div>
  </div>

{% endif %}
