---
layout: base.njk
section: home
---
{% from "macros.njk" import lsRow, rule %}

<!-- ══ HERO ══════════════════════════════════════════════════════════ -->
<section class="relative pb-20 pt-4 sm:pt-10">

  <!-- The line that opens every film, in its own blue. -->
  <p class="mb-10 max-w-xl font-sans text-base leading-relaxed text-blue sm:text-lg">
    A long time ago in a galaxy far, far away....
  </p>

  <!-- Title card -->
  <h1 class="title-card mb-8 text-[clamp(2.5rem,10vw,6.5rem)] leading-[0.92]">
    {{ site.title }}
  </h1>

  <!-- Tagline -->
  <p class="mb-12 max-w-measure font-sans text-lg leading-relaxed text-ink-dim" data-type="{{ site.description }}">
    <span class="sr-only">{{ site.description }}</span>
    <span aria-hidden="true"><span data-type-out></span><span class="text-signal cursor-block"></span></span>
  </p>

  <!-- Readout -->
  <dl class="grid max-w-2xl grid-cols-2 gap-px border border-line bg-line sm:grid-cols-4">
    {% set stats = [
      { k: "records", v: collections.posts.length | default(0) },
      { k: "notes",   v: collections.notes.length | default(0) },
      { k: "topics",  v: collections.validTagList.length | default(0) },
      { k: "frames",  v: photos.length | default(0) }
    ] %}
    {% for s in stats %}
      <div class="bg-bg px-4 py-3">
        <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">{{ s.k }}</dt>
        <dd class="mt-1 crawl-type text-2xl leading-none text-signal">{{ s.v }}</dd>
      </div>
    {% endfor %}
  </dl>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="/posts/" class="btn">
      <span aria-hidden="true">▸</span> read the archive
    </a>
    <a href="/notes/" class="btn-ghost">
      <span aria-hidden="true">▸</span> browse notes
    </a>
    <button type="button" data-cmdk-open class="btn-ghost">
      <span aria-hidden="true">⌘</span> open command palette
    </button>
  </div>
</section>

<!-- ══ TRANSMISSIONS ═════════════════════════════════════════════════ -->
<section class="pb-24" data-reveal>
  {% set postslist = collections.posts %}

  {% if postslist.length === 0 %}

    {{ rule("no signal", "0 records on disk") }}

    <div class="panel bracketed group overflow-hidden">
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> test pattern</span>
        <span class="text-signal/50">NO CONTACT</span>
      </div>

      <!-- Signal-strength ladder, brightest to dark. -->
      <div class="flex h-28 sm:h-40" aria-hidden="true">
        <div class="flex-1 bg-signal"></div>
        <div class="flex-1 bg-signal/80"></div>
        <div class="flex-1 bg-signal/60"></div>
        <div class="flex-1 bg-signal/45"></div>
        <div class="flex-1 bg-signal/30"></div>
        <div class="flex-1 bg-signal/20"></div>
        <div class="flex-1 bg-signal/10"></div>
        <div class="flex-1 bg-signal/5"></div>
      </div>

      <div class="panel-body pool">
        <p class="crawl-type text-3xl leading-none text-signal sm:text-4xl">NO SIGNAL</p>
        <p class="mt-4 max-w-measure font-mono text-sm leading-relaxed text-ink-dim">
          The archive is empty — nothing has been committed to disk yet. The scanners are
          clear and the channel is open; the first transmission just hasn't been sent.
        </p>
        <p class="mt-6 font-mono text-sm text-ink-faint">
          <span class="text-signal/60">$</span> ls -la src/posts/*.md<br>
          <span class="text-warn">ls: no matches found</span>
        </p>
        <p class="mt-6 font-mono text-xs text-ink-faint">
          Drop a <code class="border border-line-2 px-1 py-0.5 text-ink-dim">YYYY-MM-DD-slug.md</code>
          into <code class="border border-line-2 px-1 py-0.5 text-ink-dim">src/posts/</code> and this panel
          becomes the listing.
        </p>
      </div>
    </div>

  {% else %}

    {{ rule("transmissions", postslist.length + " records") }}

    <div class="panel">
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> ~/posts</span>
        <span class="text-signal/50">sorted: mtime desc</span>
      </div>
      <ul class="divide-y divide-line/60">
        {% for post in postslist %}
          {{ lsRow(post) }}
        {% endfor %}
      </ul>
    </div>

  {% endif %}
</section>

<!-- ══ NOTES ═════════════════════════════════════════════════════════ -->
{% if collections.notes.length %}
<section class="pb-24" data-reveal>
  {{ rule("notes", collections.notes.length + " entries") }}

  <div class="panel">
    <div class="panel-hd">
      <span><span class="text-signal/50" aria-hidden="true">▚▚</span> /var/log/notes</span>
      <span class="flex items-center gap-2 text-signal/50">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-ok animate-bar-pulse" aria-hidden="true"></span>
        listening
      </span>
    </div>

    <ol class="divide-y divide-line/60">
      {% for note in collections.notes | limit(3) %}
        <li class="group border-l-2 border-transparent px-4 py-4 transition-colors duration-150 hover:border-signal/60 hover:bg-signal/[0.05]">
          <div class="mb-2 flex items-center gap-3 font-mono text-[10px] uppercase tracking-widest text-ink-faint">
            <time datetime="{{ note.date | dateToRfc3339 }}">{{ note.date | htmlDateString }} {{ note.date | utcTime }}</time>
            <span aria-hidden="true" class="text-line-2">·</span>
            <span>{{ note.templateContent | charCount }} B</span>
          </div>
          <div class="note-body max-w-measure font-mono text-[15px] leading-[1.7] text-ink">
            {{ note.templateContent | safe }}
          </div>
        </li>
      {% endfor %}
    </ol>

    <a href="/notes/" class="group flex items-center gap-2 border-t border-line px-4 py-2.5 font-mono text-[11px] text-ink-dim transition-colors hover:bg-signal/[0.06] hover:text-signal">
      tail the full log
      <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
{% endif %}

<!-- ══ SUBSYSTEMS ════════════════════════════════════════════════════ -->
<section class="pb-24" data-reveal>
  {{ rule("subsystems", "5 mounted") }}

  <div class="grid gap-4 md:grid-cols-6">

    <!-- Projects -->
    <a href="/projects/" class="group panel bracketed pool relative md:col-span-4">
      <div class="wipe"></div>
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> proc</span>
        <span class="text-signal/50">{{ projects.length | default(0) }} running</span>
      </div>
      <div class="panel-body">
        <h3 class="crawl-type text-2xl leading-none text-signal">Projects</h3>
        <p class="mt-2 font-mono text-sm text-ink-dim">What is currently drawing power.</p>

        <ul class="mt-6 space-y-1.5 font-mono text-xs">
          {% for project in projects %}
            {% if loop.index0 < 3 %}
              <li class="flex items-center gap-3 border border-line bg-bg-deep/40 px-3 py-2">
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full {% if project.status == 'active' %}bg-ok{% else %}bg-signal{% endif %}" aria-hidden="true"></span>
                <span class="text-ink-hi">{{ project.name }}</span>
                <span class="ml-auto uppercase tracking-widest text-ink-faint">{{ project.status }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-signal transition-transform duration-200 group-hover:translate-x-1">
          top <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>

    <!-- Photography -->
    <a href="/photography/" class="group panel bracketed pool relative flex flex-col md:col-span-2">
      <div class="wipe"></div>
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> fb0</span>
        <span class="text-signal/50">{{ photos.length | default(0) }}</span>
      </div>
      <div class="panel-body flex flex-1 flex-col">
        <h3 class="crawl-type text-2xl leading-none text-signal">Frame buffer</h3>
        <p class="mt-2 font-mono text-sm text-ink-dim">Light, captured and quantised.</p>

        <div class="mt-6 flex gap-1.5 overflow-hidden">
          {% for photo in photos %}
            {% if loop.index0 < 3 %}
              <span class="duotone block h-16 w-16 shrink-0 overflow-hidden border border-line">
                <img src="{{ photo.src | replace('./src', '') }}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover">
              </span>
            {% endif %}
          {% endfor %}
        </div>

        <span class="mt-auto pt-6 inline-flex items-center gap-2 font-mono text-xs text-signal transition-transform duration-200 group-hover:translate-x-1">
          open <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>

    <!-- Notes -->
    <a href="/notes/" class="group panel bracketed pool relative md:col-span-2">
      <div class="wipe"></div>
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> notes</span>
        <span class="text-signal/50">{{ collections.notes.length | default(0) }}</span>
      </div>
      <div class="panel-body">
        <h3 class="crawl-type text-2xl leading-none text-signal">Notes</h3>
        <p class="mt-2 max-w-measure font-mono text-sm leading-relaxed text-ink-dim">
          Short notes. Half-thoughts, links, things not worth a whole record.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-signal transition-transform duration-200 group-hover:translate-x-1">
          tail -f <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>

    <!-- About -->
    <a href="/about/" class="group panel bracketed pool relative md:col-span-2">
      <div class="wipe"></div>
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> id</span>
        <span class="text-signal/50">uid 1000</span>
      </div>
      <div class="panel-body">
        <h3 class="crawl-type text-2xl leading-none text-signal">whoami</h3>
        <p class="mt-2 max-w-measure font-mono text-sm leading-relaxed text-ink-dim">
          {{ site.author }} — {{ site.role }}. The operator record, hardware inventory and
          contact channels.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-signal transition-transform duration-200 group-hover:translate-x-1">
          cat /etc/passwd <span aria-hidden="true">→</span>
        </span>
      </div>
    </a>

    <!-- Feed -->
    <a href="/feed.xml" class="group panel bracketed pool relative md:col-span-2">
      <div class="wipe"></div>
      <div class="panel-hd">
        <span><span class="text-signal/50" aria-hidden="true">▚▚</span> uplink</span>
        <span class="text-signal/50">rss 2.0</span>
      </div>
      <div class="panel-body">
        <h3 class="crawl-type text-2xl leading-none text-signal">Subscribe</h3>
        <p class="mt-2 max-w-measure font-mono text-sm leading-relaxed text-ink-dim">
          No newsletter, no tracking pixel. Point a reader at the raw feed and new records
          arrive on their own.
        </p>
        <code class="mt-6 block border border-line bg-bg-deep/50 px-3 py-2 font-mono text-xs text-ink-hi">
          {{ site.url }}/feed.xml
        </code>
      </div>
    </a>
  </div>
</section>
