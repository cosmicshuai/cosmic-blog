---
layout: base.njk
title: Projects
section: projects
description: Process table — what is currently drawing power.
---
{% from "macros.njk" import rule %}

<header class="mb-12 pt-4">
  <p class="mb-3 font-mono text-sm text-ink-dim">
    <span class="text-signal">$</span> top -o state
  </p>
  <h1 class="title-card text-[clamp(2.5rem,9vw,5.5rem)] leading-[0.92]">Projects</h1>
  <p class="mt-4 max-w-measure font-mono text-sm leading-relaxed text-ink-dim">
    <span class="text-ink-hi">{{ projects.length | default(0) }}</span> processes in the table.
    Ideas at the seam between systems, performance and the people using them.
  </p>
</header>

{% if projects.length === 0 %}
  <div class="panel bracketed group">
    <div class="panel-hd">
      <span><span class="text-signal/50" aria-hidden="true">▚▚</span> proc</span>
      <span class="text-signal/50">0 running</span>
    </div>
    <div class="panel-body">
      <p class="crawl-type text-2xl text-signal">NO PROCESSES</p>
      <p class="mt-3 max-w-measure font-mono text-sm text-ink-dim">
        Populate <code class="border border-line-2 px-1 py-0.5">src/_data/projects.json</code> to fill this table.
      </p>
    </div>
  </div>
{% else %}

  <div class="panel mb-10" data-reveal>
    <div class="panel-hd">
      <span><span class="text-signal/50" aria-hidden="true">▚▚</span> process table</span>
      <span class="text-signal/50">refresh 1s</span>
    </div>

    <!-- Column key -->
    <div class="hidden grid-cols-[5ch_1fr_10ch_14ch] gap-x-4 border-b border-line px-3 py-1.5 font-mono text-[10px] uppercase tracking-widest text-ink-faint sm:grid">
      <span>pid</span><span>command</span><span>state</span><span>load</span>
    </div>

    <ul class="divide-y divide-line/60">
      {% for project in projects %}
        {% if project.status == "active" %}
          {% set load = 8 %}{% set stateColor = "text-ok" %}
        {% elif project.status == "wip" %}
          {% set load = 5 %}{% set stateColor = "text-signal" %}
        {% else %}
          {% set load = 1 %}{% set stateColor = "text-ink-faint" %}
        {% endif %}

        <li>
          <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer"
             class="group grid grid-cols-1 items-baseline gap-x-4 gap-y-2 border-l-2 border-transparent px-3 py-4 font-mono text-sm transition-colors hover:border-signal hover:bg-signal/[0.07] sm:grid-cols-[5ch_1fr_10ch_14ch]">

            <span class="hidden text-ink-faint sm:inline" aria-hidden="true">{{ 1000 + loop.index0 * 7 }}</span>

            <span class="block">
              <span class="block text-base text-ink-hi transition-colors group-hover:text-signal">
                {{ project.name }}
                <span class="ml-1 text-xs text-ink-faint transition-transform duration-200 group-hover:translate-x-1 inline-block" aria-hidden="true">↗</span>
              </span>
              <span class="mt-1 block max-w-measure text-[13px] leading-relaxed text-ink-dim">{{ project.description }}</span>
              {% if project.tags %}
                <span class="mt-2 flex flex-wrap gap-1.5">
                  {% for tag in project.tags %}
                    <span class="border border-line-2 px-1.5 py-0.5 text-[11px] text-ink-faint">{{ tag }}</span>
                  {% endfor %}
                </span>
              {% endif %}
            </span>

            <span class="text-xs uppercase tracking-widest {{ stateColor }}">
              <span class="inline-block h-1.5 w-1.5 rounded-full align-middle {% if project.status == 'active' %}bg-ok animate-bar-pulse{% elif project.status == 'wip' %}bg-signal{% else %}bg-ink-faint{% endif %}" aria-hidden="true"></span>
              {{ project.status }}
            </span>

            <span class="flex items-center gap-2 text-xs">
              <span aria-hidden="true" class="tracking-[0.1em] text-signal">{% for i in range(0, load) %}█{% endfor %}<span class="text-ink-faint">{% for i in range(load, 10) %}░{% endfor %}</span></span>
              <span class="text-ink-faint">{{ load * 10 }}%</span>
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>

    <div class="border-t border-line px-3 py-2 font-mono text-[11px] text-ink-faint">
      load average: {{ projects.length }}.00 — all processes nominal
    </div>
  </div>

{% endif %}
